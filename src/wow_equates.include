; wow_equates.include
; ==============================================================================
; Wizard of Wor - Master Hardware Equates
; ==============================================================================

HIGH_ROM_INIT_HOOK              EQU     $8006       ; Low ROM probes for JP; WoW maps this to Sound_Reset_All_Entry

; ------------------------------------------------------------------------------
; SYSTEM INPUTS & SWITCHES
; ------------------------------------------------------------------------------
COINPORT    EQU     $10         ; System Inputs
P2PORT      EQU     $11         ; Player 2 / Cocktail Controls
P1PORT      EQU     $12         ; Player 1 Controls
SETTINGS    EQU     $13         ; Dip Switches
CCMISC      EQU     $15         ; Special Control Register 1

; ------------------------------------------------------------------------------
; VIDEO & COLOR CONTROL PORTS
; ------------------------------------------------------------------------------
COL0R       EQU     $00         ; Color 0 Right
COL1R       EQU     $01         ; Color 1 Right
COL2R       EQU     $02         ; Color 2 Right
COL3R       EQU     $03         ; Color 3 Right
COL0L       EQU     $04         ; Color 0 Left
COL1L       EQU     $05         ; Color 1 Left
COL2L       EQU     $06         ; Color 2 Left
COL3L       EQU     $07         ; Color 3 Left
CONCM       EQU     $08         ; Consumer/Commercial Mode
HORCB       EQU     $09         ; Horizontal Color Boundary
VERBL       EQU     $0A         ; Vertical Blanking Line
COLBX       EQU     $0B         ; Color Block Output Port
MAGIC       EQU     $0C         ; Magic RAM Control Register
XPAND       EQU     $19         ; Expand Mode Color Definition

; ------------------------------------------------------------------------------
; INTERRUPT & SYSTEM CONTROL PORTS
; ------------------------------------------------------------------------------
INTST       EQU     $08         ; Intercept Status (Hardware Collision)
INFBK       EQU     $0D         ; IM2 vector low byte / interrupt feedback register
INMOD       EQU     $0E         ; Interrupt source/mode enable register
INLIN       EQU     $0F         ; Scanline interrupt compare register

; WoW keeps I=$00 and selects among three little-endian vectors stored in ROM.
IM2_VECTOR_PAGE_00              EQU     $00
IM2_VECTOR_CA                   EQU     $CA
IM2_VECTOR_CC                   EQU     $CC
IM2_VECTOR_CE                   EQU     $CE
RIGHTPORT   EQU     $5B         ; NVRAM Write-Protect Port
RIGHTVALUE  EQU     $A5         ; NVRAM Unlock Value

; ------------------------------------------------------------------------------
; ASTROCADE CUSTOM I/O IC SOUND OUTPUT PORTS
;
; These names are output-side aliases. The same numeric I/O addresses also have
; input-side functions on the arcade hardware, so IN and OUT uses are distinct.
; ------------------------------------------------------------------------------
TONMO       EQU     $10         ; Master oscillator divider
TONEA       EQU     $11         ; Tone A divider
TONEB       EQU     $12         ; Tone B divider
TONEC       EQU     $13         ; Tone C divider
VIBRA       EQU     $14         ; Bits 7-6 vibrato speed; bits 5-0 vibrato depth
VOLC        EQU     $15         ; Bit 5 noise enable; bit 4 modulation select; bits 3-0 Tone C volume
VOLAB       EQU     $16         ; Bits 7-4 Tone B volume; bits 3-0 Tone A volume
VOLN        EQU     $17         ; 8-bit noise-modulation mask; bits 7-4 audible noise level when VOLC bit 5 is set
SNDBX       EQU     $18         ; Descending 8-register block transfer: $17 through $10

SOUND2_TONMO                    EQU     $50         ; Secondary master oscillator divider
SOUND2_TONEA                    EQU     $51         ; Secondary Tone A divider
SOUND2_TONEB                    EQU     $52         ; Secondary Tone B divider
SOUND2_TONEC                    EQU     $53         ; Secondary Tone C divider
SOUND2_VIBRA                    EQU     $54         ; Secondary vibrato control
SOUND2_VOLC                     EQU     $55         ; Secondary Tone C/modulation/noise control
SOUND2_VOLAB                    EQU     $56         ; Secondary Tone A/B volume
SOUND2_VOLN                     EQU     $57         ; Secondary noise mask/level
SOUND2_SNDBX                    EQU     $58         ; Secondary descending 8-register block transfer

SOUND_VIBRATO_DEPTH_MASK        EQU     $3F
SOUND_VIBRATO_SPEED_MASK        EQU     $C0
SOUND_VOLC_TONE_C_MASK          EQU     $0F
SOUND_VOLC_MODULATION_NOISE     EQU     $10         ; 1 = noise modulation, 0 = vibrato modulation
SOUND_VOLC_NOISE_ENABLE         EQU     $20         ; Mix audible noise with tones
SOUND_VOLAB_TONE_A_MASK         EQU     $0F
SOUND_VOLAB_TONE_B_MASK         EQU     $F0
SOUND_VOLN_AUDIBLE_MASK         EQU     $F0

VOTRAX_DATA_PORT                 EQU     $17         ; SC-01 command strobe via IN; command supplied in B
VOTRAX_READY_BIT                 EQU     7           ; P1PORT bit 7, SC-01 A/R: 1 = ready
VOTRAX_PHONEME_MASK              EQU     $3F         ; Command bits 0-5
VOTRAX_DIRECT_BIT6_MASK           EQU     $40         ; Command bit 6 passes directly from ROM
VOTRAX_DIFFERENTIAL_BIT7_MASK    EQU     $80         ; Differential bit-7 state used by WoW speech data
VOTRAX_STOP_COMMAND              EQU     $3F17       ; B=$3F STOP phoneme, C=$17 Votrax data port

; ------------------------------------------------------------------------------
; PATTERN BOARD (DMA) PORTS
; ------------------------------------------------------------------------------
PBLINADRL   EQU     $78         ; LSB of Source Address
PBLINADRH   EQU     $79         ; MSB of Source Address
PBSTAT      EQU     $7A         ; Pattern Board Status / Copy Mode
PBXMOD      EQU     $7B         ; LSB of Dest Address / Skip Low
PBAREADRH   EQU     $7C         ; MSB of Destination Address
PBXWIDE     EQU     $7D         ; Width of pattern row
PBYHIGH     EQU     $7E         ; Height of pattern to copy

; ------------------------------------------------------------------------------
; HARDWARE BITMASKS
; ------------------------------------------------------------------------------
MRROT       EQU     2           ; Magic: Rotate 90 degrees
MRXPND      EQU     3           ; Magic: Expand 1bpp to 2bpp
MROR        EQU     4           ; Magic: OR mode
MRXOR       EQU     5           ; Magic: Exclusive-OR mode
MRFLOP      EQU     6           ; Magic: Flop (Horizontal mirror)
MRFLIP      EQU     7           ; Magic: Flip (Vertical mirror)

PBDIR       EQU     0           ; DMA: Transfer Direction
PBEXP       EQU     1           ; DMA: Expand Mode
PBCONS      EQU     2           ; DMA: Constant Mode
PBFLUSH     EQU     3           ; DMA: Flush
PBFLIP      EQU     4           ; DMA: Vertical Flip
PBFLOP      EQU     5           ; DMA: Horizontal Flop

; ------------------------------------------------------------------------------
; GAME MEMORY MAP
; ------------------------------------------------------------------------------
BOOT_STACK_TOP                   EQU     $D400       ; Temporary work-RAM stack used during boot/diagnostics
PERMANENT_STACK_TOP              EQU     $8000       ; SP boundary; pushes descend into non-visible VRAM below $8000

; Protected RAM and timers
Coin_Input_Latch                 EQU     $D03B
Credits                          EQU     $D03C
Timer_Group_1_Start              EQU     $D042
Timer_Group_2_Start              EQU     $D048

; Actor records
P1_Actor_Record                  EQU     $D054
P2_Actor_Record                  EQU     $D074
Enemy_1_Actor_Record             EQU     $D094
Enemy_2_Actor_Record             EQU     $D0BA
Enemy_3_Actor_Record             EQU     $D0E0
Enemy_4_Actor_Record             EQU     $D106
Enemy_5_Actor_Record             EQU     $D12C
Enemy_6_Actor_Record             EQU     $D152

; Player input and display state
P2_Input_State                   EQU     $D1DC
P1_Input_State                   EQU     $D1DD
Combined_Player_Inputs           EQU     $D1DE
Status_Display_Update_Flags      EQU     $D1E5
P2_Auto_Input_State              EQU     $D1ED
P1_Auto_Input_State              EQU     $D1EE

; Sound and speech state
Sound_Request_1                  EQU     $D240       ; All set bits are processed; bits 6/7 reset secondary/primary engine
Sound_Request_2                  EQU     $D241       ; First recognized set bit is dispatched from each consumed byte
Sound_Request_3                  EQU     $D242       ; First recognized set bit is dispatched from each consumed byte
Sound_Request_4                  EQU     $D243       ; First recognized set bit is dispatched from each consumed byte
Sound_Service_Enabled            EQU     $D244       ; Nonzero enables normal $84F2 sound/speech service
Speech_Active                    EQU     $D245

Primary_Sound_Modulator_Area     EQU     $D246       ; Six 7-byte modulator slots, cleared by primary reset
Primary_Sound_Engine_Record      EQU     $D270       ; 18-byte primary engine record
Secondary_Sound_Modulator_Area   EQU     $D282       ; Six 7-byte modulator slots, cleared by secondary reset
Secondary_Sound_Engine_Record    EQU     $D2AC       ; 18-byte secondary engine record

SOUND_MODULATOR_SLOT_SIZE        EQU     $07
SOUND_MODULATOR_SLOT_COUNT       EQU     $06
SOUND_MODULATOR_AREA_SIZE        EQU     $2A
SOUND_ENGINE_RECORD_SIZE         EQU     $12
SOUND_ENGINE_BUNDLE_SIZE         EQU     $3C

; Modulator-slot offsets.
SNDMOD_COUNTDOWN                 EQU     $00
SNDMOD_RELOAD                    EQU     $01
SNDMOD_CONTROL                   EQU     $02
SNDMOD_STEP                      EQU     $03
SNDMOD_BOUNDARY_A                EQU     $04
SNDMOD_BOUNDARY_B                EQU     $05
SNDMOD_COMPLETION_COUNT          EQU     $06
SNDMOD_FLAG_ENABLED             EQU     $01
SNDMOD_FLAG_SNAP_TO_BOUNDARY    EQU     $02
SNDMOD_FLAG_RANDOM_PATH         EQU     $04
SNDMOD_FLAG_TRANSITION_PATH     EQU     $08
SNDMOD_FLAG_BOUNDARY_SELECT     EQU     $10
SNDMOD_FLAG_STREAM_READY_ON_COMPLETE EQU $20

; Engine-record offsets. Bytes $04-$0B are stored in SNDBX transfer order.
SNDREC_BLOCK_PORT                EQU     $00         ; $18 primary, $58 secondary
SNDREC_STREAM_PTR_LO             EQU     $01
SNDREC_STREAM_PTR_HI             EQU     $02
SNDREC_PRIORITY                  EQU     $03
SNDREC_VOLN                      EQU     $04         ; $17 / $57 image
SNDREC_VOLAB                     EQU     $05         ; $16 / $56 image
SNDREC_VOLC                      EQU     $06         ; $15 / $55 image
SNDREC_VIBRA                     EQU     $07         ; $14 / $54 image
SNDREC_TONEC                     EQU     $08         ; $13 / $53 image
SNDREC_TONEB                     EQU     $09         ; $12 / $52 image
SNDREC_TONEA                     EQU     $0A         ; $11 / $51 image
SNDREC_TONMO                     EQU     $0B         ; $10 / $50 image
SNDREC_MASTER_VOLUME_COUPLING    EQU     $0C         ; Enables slot-5-to-slot-4 coupling
SNDREC_WAIT_COUNTER              EQU     $0D         ; Stream wait counter; expiry sets STREAM_READY
SNDREC_BYTE_0E                   EQU     $0E         ; No resident sound-engine references
SNDREC_BYTE_0F                   EQU     $0F         ; No resident sound-engine references
SNDREC_SERVICE_FLAG              EQU     $10         ; Checked, set, then cleared by per-engine periodic service
SNDREC_STREAM_READY              EQU     $11         ; Nonzero allows stream decoding

; Signed offsets from an engine record to its six 7-byte modulator slots.
SNDMOD_SLOT_0_OFFSET             EQU     $FFD6       ; -42; updates slot 5 reload value
SNDMOD_SLOT_1_OFFSET             EQU     $FFDD       ; -35; updates VOLN
SNDMOD_SLOT_2_OFFSET             EQU     $FFE4       ; -28; updates slot 5 step value
SNDMOD_SLOT_3_OFFSET             EQU     $FFEB       ; -21; updates VIBRA
SNDMOD_SLOT_4_OFFSET             EQU     $FFF2       ; -14; updates Tone A/B/C volumes together
SNDMOD_SLOT_5_OFFSET             EQU     $FFF9       ;  -7; updates TONMO

; Sound request masks recognized by the native dispatcher.
SOUND_R1_B0_MASK                 EQU     $01
SOUND_R1_B1_MASK                 EQU     $02
SOUND_R1_B2_MASK                 EQU     $04
SOUND_R1_B3_MASK                 EQU     $08
SOUND_R1_B4_MASK                 EQU     $10
SOUND_R1_B5_MASK                 EQU     $20
SOUND_R1_RESET_SECONDARY_MASK    EQU     $40
SOUND_R1_RESET_PRIMARY_MASK      EQU     $80
SOUND_R2_B0_MASK                 EQU     $01
SOUND_R2_B1_MASK                 EQU     $02
SOUND_R2_B2_MASK                 EQU     $04
SOUND_R2_B3_MASK                 EQU     $08
SOUND_R2_B4_MASK                 EQU     $10
SOUND_R2_IGNORED_B5_MASK         EQU     $20
SOUND_R2_B6_MASK                 EQU     $40
SOUND_R2_B7_MASK                 EQU     $80
SOUND_R3_B0_MASK                 EQU     $01
SOUND_R3_B1_MASK                 EQU     $02
SOUND_R3_B2_MASK                 EQU     $04
SOUND_R3_B3_MASK                 EQU     $08
SOUND_R3_B4_MASK                 EQU     $10
SOUND_R3_B5_MASK                 EQU     $20
SOUND_R3_IGNORED_B6_MASK         EQU     $40
SOUND_R3_B7_MASK                 EQU     $80
SOUND_R4_B0_MASK                 EQU     $01
SOUND_R4_B1_MASK                 EQU     $02
SOUND_R4_B2_MASK                 EQU     $04
SOUND_R4_B3_MASK                 EQU     $08
SOUND_R4_IGNORED_B4_B7_MASK      EQU     $F0

; WoW resident sound-stream opcodes ($00-$17).
SOUND_OP_YIELD                   EQU     $00
SOUND_OP_WAIT                    EQU     $01
SOUND_OP_JUMP                    EQU     $02
SOUND_OP_RESET_ENGINE            EQU     $03
SOUND_OP_LOAD_MODULATOR          EQU     $04
SOUND_OP_SET_MODULATOR_COMPLETION_COUNT EQU $05
SOUND_OP_ENABLE_MODULATOR        EQU     $06
SOUND_OP_DISABLE_MODULATOR       EQU     $07
SOUND_OP_ENABLE_MASTER_VOLUME_COUPLING EQU $08
SOUND_OP_SET_PRIORITY_1          EQU     $09
SOUND_OP_SET_PRIORITY_0          EQU     $0A
SOUND_OP_TONMO                   EQU     $10
SOUND_OP_TONEA                   EQU     $11
SOUND_OP_TONEB                   EQU     $12
SOUND_OP_TONEC                   EQU     $13
SOUND_OP_VIBRA                   EQU     $14
SOUND_OP_VOLC                    EQU     $15
SOUND_OP_VOLAB                   EQU     $16
SOUND_OP_VOLN                    EQU     $17
SOUND_STREAM_OPCODE_COUNT        EQU     $18
SOUND_PRIORITY_0                 EQU     $00
SOUND_PRIORITY_1                 EQU     $01
SOUND_PRIORITY_2                 EQU     $02

Speech_Queue_Buffer              EQU     $D2BE       ; Eight 2-byte fragment-pointer records
Speech_Queue_Last_Record         EQU     $D2CC       ; Last valid record start
SPEECH_QUEUE_RECORD_SIZE         EQU     $02
SPEECH_QUEUE_RECORD_COUNT        EQU     $08
SPEECH_QUEUE_SIZE                EQU     $10
Speech_Phoneme_Pointer           EQU     $D2CE
Speech_Phonemes_Remaining        EQU     $D2D0
Speech_Inflection_State          EQU     $D2D1
Speech_Queue_Write_Pointer       EQU     $D2D2
Speech_Queue_Read_Pointer        EQU     $D2D4

; Game progression
P1_Lives                         EQU     $D300
P2_Lives                         EQU     $D301
Dungeon_Number                   EQU     $D302
Game_Mode                        EQU     $D303
Maze_Index                       EQU     $D318
Coin_Events_Pending              EQU     $D340
Free_Play_Enabled                EQU     $D348
Random_Seed                      EQU     $D34A
One_Second_Frame_Countdown       EQU     $D34E
Starting_Lives_Dip               EQU     $D34F
Dungeon_Class                    EQU     $D350       ; $00 basic, $01 Worlord, $02 Pit
Maze_Selection_Flags             EQU     $D354

; Video RAM destinations
Left_Status_Display_Address      EQU     $2C67
Right_Status_Display_Address     EQU     $2CA3

; ------------------------------------------------------------------------------
; ACTOR RECORD LAYOUT
; ------------------------------------------------------------------------------
ACTOR_FLAGS                      EQU     $00
ACTOR_X                          EQU     $04
ACTOR_Y                          EQU     $06
ACTOR_FACING                     EQU     $07
ACTOR_SHOT_FLAGS                 EQU     $13
PLAYER_ACTOR_RECORD_SIZE         EQU     $20
ENEMY_ACTOR_RECORD_SIZE          EQU     $26
MAX_ENEMY_ACTORS                 EQU     $06

; ------------------------------------------------------------------------------
; GAME CONSTANTS
; ------------------------------------------------------------------------------
GAME_MODE_ATTRACT                EQU     $00
GAME_MODE_ONE_PLAYER             EQU     $01
GAME_MODE_TWO_PLAYER             EQU     $02

DUNGEON_CLASS_WORLORD            EQU     $01
DUNGEON_CLASS_PIT                EQU     $02

MAZE_COUNT                       EQU     $18
PACKED_MAZE_RECORD_SIZE          EQU     $12
MAZE_SELECTION_FLAG_COUNT        EQU     $17

DIP_STARTING_LIVES               EQU     $10
DIP_BONUS_LIFE                   EQU     $20
DIP_FREE_PLAY                    EQU     $40
DIP_ATTRACT_SOUND                EQU     $80

; ------------------------------------------------------------------------------
; PARTIALLY IDENTIFIED RAM
; ------------------------------------------------------------------------------
LD038       EQU     $D038               ; Protected-RAM value/complement pair at $D038-$D039
LD1D6       EQU     $D1D6               ; Diagnostic input scratch; runtime role not fully identified
LD1D7       EQU     $D1D7               ; Diagnostic input scratch; runtime role not fully identified
LD349       EQU     $D349               ; Read by the pending-coin handler; producer not yet identified

;******************************************************************************
; X11 FOREIGN-LANGUAGE ROM ABI ($C000-$CFFF)
;
; Bit 3 set selects resident English text/speech/coinage resources; bit 3 clear
; selects the X11 equivalents. Text, speech, coinage, and diagnostics sample the
; DIP independently. The alternate-font path reads X11_Alternate_Font_Ptr
; directly when char2gfx routes a character to the alternate glyph range.
;******************************************************************************
X11_Speech_Fragment_Table_Ptr    EQU     $C000
X11_Speech_Phrase_Table_Ptr      EQU     $C002
X11_Coinage_Value_Table          EQU     $C004
X11_ROM_Checksum_Expected        EQU     $C00A
X11_Alternate_Font_Ptr           EQU     $C00B
X11_Localized_Text_Table         EQU     $C00D

LANGUAGE_DIP_BIT                 EQU     3
SPEECH_PHRASE_COUNT              EQU     $50
SPEECH_FRAGMENT_COUNT_MASK       EQU     $7F
SPEECH_FRAGMENT_WORRIOR          EQU     $09
SPEECH_FRAGMENT_WORRIOR_PADDED   EQU     $37
SPEECH_FRAGMENT_WORLORD          EQU     $40
SPEECH_FRAGMENT_WORLORD_PADDED   EQU     $41

; ------------------------------------------------------------------------------
; RAW ADDRESS CONSTANTS WITHOUT VERIFIED SEMANTIC NAMES
; ------------------------------------------------------------------------------
