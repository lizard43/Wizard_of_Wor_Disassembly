; ==============================================================================
; Disassembly of the Wizard of Wor Version 2 ROM
; ==============================================================================
;
; ------------------------------------------------------------------------------
; MEMORY MAP
; ------------------------------------------------------------------------------
;  $0000-$3FFF  ROMs X1-X4 (Also Magic RAM area for Pattern Board writes)
;  $4000-$7FBF  Viewable SCREEN RAM (Bitmap, $50 bytes wide per line)
;  $7FC0-$7FFF  Non-viewable Video Margin (Repurposed for Z80 STACK)
;  $8000-$AFFF  ROMs X5-X7
;  $B000-$CFFF  Empty Sockets (X8, X11)
;  $D000-$D3FF  Protected Static RAM (Requires $A5 unlock byte at port $5B)
;  $D400-$DFFF  Empty static RAM (Temporary stack during boot)
;
;  ROM CRCs: x1(c1295786) x2(9be93215) x3(75e5a22e) x4(ef28eb84)
;            x5(16912c2b) x6(35797f82) x7(ce404305)
; ------------------------------------------------------------------------------
;
;  EXPHOOK     EQU     $8006       ; Expansion ROM jump hook (Game checks for $C3)
;
; ------------------------------------------------------------------------------
; SYSTEM INPUTS & SWITCHES (Active Low unless noted)
; ------------------------------------------------------------------------------
;  COINPORT    EQU     $10         ; System Inputs
;                                  ;   bit 0-2: Coin Inputs 1, 2, 3
;                                  ;   bit 3: Service/Diagnostic Switch
;                                  ;   bit 4: Tilt / Slam
;                                  ;   bit 5-6: Player 1 & 2 Start
;                                  ;   bit 7: Cocktail Mode / Flip Screen
;  P2PORT      EQU     $11         ; Player 2 / Cocktail Controls
;  P1PORT      EQU     $12         ; Player 1 Controls
;                                  ;   bit 0-3: Up, Down, Left, Right
;                                  ;   bit 4: Button 2 (Active HIGH)
;                                  ;   bit 5: Button 1
;                                  ;   bit 7: Speech Status (Active HIGH)
;  SETTINGS    EQU     $13         ; Dip Switches
;                                  ;   bit 0-2: Coin slot pricing settings
;                                  ;   bit 3: Language (Off=Foreign, On=English)
;                                  ;   bit 4: Lives (Off=3/7, On=2/5)
;                                  ;   bit 5: Bonus Life (Off=4th, On=3rd)
;                                  ;   bit 6: Free Play
;                                  ;   bit 7: Demo Sounds (Off=Quiet, On=Demo)
;  CCMISC      EQU     $15         ; Special Control Register 1 (via Z80 'IN' hook)
;                                  ;   0000 xxx y (xxx = func 0-7, y=0 on, y=1 off)
;
; ------------------------------------------------------------------------------
; VIDEO & COLOR CONTROL PORTS
; ------------------------------------------------------------------------------
;  COL0R       EQU     $00         ; Color 0 Right
;  COL1R       EQU     $01         ; Color 1 Right
;  COL2R       EQU     $02         ; Color 2 Right
;  COL3R       EQU     $03         ; Color 3 Right
;  COL0L       EQU     $04         ; Color 0 Left
;  COL1L       EQU     $05         ; Color 1 Left
;  COL2L       EQU     $06         ; Color 2 Left
;  COL3L       EQU     $07         ; Color 3 Left
;  CONCM       EQU     $08         ; Consumer/Commercial Mode (1 = High Res 320x204)
;  HORCB       EQU     $09         ; Horizontal Color Boundary / Background Color
;  VERBL       EQU     $0A         ; Vertical Blanking Line (Screen Height)
;  COLBX       EQU     $0B         ; Color Block Output Port
;  MAGIC       EQU     $0C         ; Magic RAM Control Register
;  XPAND       EQU     $19         ; Expand Mode Color Definition Port
;
; ------------------------------------------------------------------------------
; INTERRUPT & SYSTEM CONTROL PORTS
; ------------------------------------------------------------------------------
;  INTST       EQU     $08         ; Intercept Status (Hardware Collision detector)
;                                  ;   bit 0-3: Intercept since last reset
;                                  ;   bit 4-7: Intercept in last OR/XOR write
;  INFBK       EQU     $0D         ; Interrupt Feedback Vector
;  INMOD       EQU     $0E         ; Interrupt Mode Enable (bit 3 = line ints)
;  INLIN       EQU     $0F         ; Interrupt Scan Line / Horizontal Feedback
;  RIGHTPORT   EQU     $5B         ; NVRAM Write-Protect Port
;  RIGHTVALUE  EQU     $A5         ; Value required to unlock NVRAM writes
;
; ------------------------------------------------------------------------------
; AUDIO & MUSIC PROCESSOR PORTS
; ------------------------------------------------------------------------------
;  TONMO       EQU     $10         ; Tone Master Oscillator
;  TONEA       EQU     $11         ; Tone A Oscillator
;  TONEB       EQU     $12         ; Tone B Oscillator
;  TONEC       EQU     $13         ; Tone C Oscillator
;  VIBRA       EQU     $14         ; Vibrato Frequency/Range
;  VOLC        EQU     $15         ; Tone C Volume
;  VOLAB       EQU     $16         ; Tones A & B Volume
;  VOLN        EQU     $17         ; Noise Volume / Votrax SC-01 Speech (via IN)
;  SNDBX       EQU     $18         ; Sound Block Output Port
;
; ------------------------------------------------------------------------------
; PATTERN BOARD (DMA) PORTS
; ------------------------------------------------------------------------------
;  PBLINADRL   EQU     $78         ; LSB of Source Address (SRCLO)
;  PBLINADRH   EQU     $79         ; MSB of Source Address (SRCHI)
;  PBSTAT      EQU     $7A         ; Pattern Board Status / Copy Mode (CMODE)
;  PBXMOD      EQU     $7B         ; LSB of Dest Address / Skip Low (SKIPLO)
;  PBAREADRH   EQU     $7C         ; MSB of Destination Address (DESTHI)
;  PBXWIDE     EQU     $7D         ; Width of pattern row (LENGTH)
;  PBYHIGH     EQU     $7E         ; Height of pattern to copy (LOOPS) - Triggers DMA!
; ------------------------------------------------------------------------------
; HARDWARE BITMASKS
; ------------------------------------------------------------------------------
; Magic RAM Control (Port $0C)
;  MRROT       EQU     2           ; Rotate 90 degrees
;  MRXPND      EQU     3           ; Expand 1bpp to 2bpp
;  MROR        EQU     4           ; OR mode
;  MRXOR       EQU     5           ; Exclusive-OR mode
;  MRFLOP      EQU     6           ; Flop (Horizontal mirror)
;  MRFLIP      EQU     7           ; Flip (Vertical mirror)
;
; Pattern Board Status (Port $7A)
;  PBDIR       EQU     0           ; Transfer Direction
;  PBEXP       EQU     1           ; Expand Mode
;  PBCONS      EQU     2           ; Constant Mode
;  PBFLUSH     EQU     3           ; Flush
;  PBFLIP      EQU     4           ; Apply vertical Flip during transfer
;  PBFLOP      EQU     5           ; Apply horizontal Flop during transfer